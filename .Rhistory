mypval<-function( threshold, type){
samples<-nrow(minmax)
# If a max has a p-value >= 0.95, it has at must 5% of the distribution > observed
#If a min has a p-value <= 0.05, it has at must 5% of the distribution < observed
success<-ifelse(type =="max", sum(minmax$maxFC_pval >= 1-threshold), sum(minmax$minFC_pval <= threshold))
pbinom(success-1, size = samples, prob = threshold, lower.tail = F) #Probabilidad de n o mas successes (= probabilidad de mas de n-1)
}
# The enrichment values in the top 5% for max aka which max values have a value > 0.05
